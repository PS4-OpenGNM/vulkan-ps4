# Makefile.orbis — vulkan-ps4 PS4 build with OpenOrbis toolchain
#
# Usage:
#   export OO_PS4_TOOLCHAIN=/path/to/OpenOrbis-PS4-Toolchain
#   make -f Makefile.orbis
#
# Prerequisites:
#   - OpenOrbis PS4 Toolchain (OO_PS4_TOOLCHAIN)
#   - opengnm built for orbis (../opengnm/libopengnm.a or build-orbis/)
#   - libpsbc built for orbis (../opengnm-psbc/libpsbc.orbis.a)
#   - Vulkan-Headers (../Vulkan-Headers/)
#
# Output:
#   libvulkan_ps4.so — shared library for PS4
#   libvulkan_ps4.a  — static library for PS4 (for static linking into apps)

# === Toolchain ===
ifeq ($(strip $(OO_PS4_TOOLCHAIN)),)
$(error "Please set OO_PS4_TOOLCHAIN. export OO_PS4_TOOLCHAIN=<path to OpenOrbis-PS4-Toolchain>")
endif

# Paths to dependencies (sibling directories)
OPENGNM_ROOT  ?= $(CURDIR)/../opengnm
PSBC_ROOT     ?= $(CURDIR)/../opengnm-psbc
VK_HEADERS    ?= $(CURDIR)/../Vulkan-Headers

# Prefer the orbis-built libopengnm.a at the root, then build-orbis, then build
OPENGNM_LIBDIR ?= $(firstword $(foreach dir,$(OPENGNM_ROOT) \
    $(OPENGNM_ROOT)/build-orbis \
    $(OPENGNM_ROOT)/build,\
    $(if $(wildcard $(dir)/libopengnm.a),$(dir))) )

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
	CC := clang
	CXX := clang++
	LD := ld.lld
	AR := llvm-ar
endif
ifeq ($(UNAME_S),Darwin)
	CC := clang
	CXX := clang++
	LD := ld.lld
	AR := /opt/homebrew/opt/llvm/bin/llvm-ar
endif

# === Flags ===
ARCHFLAGS := --target=x86_64-pc-freebsd12-elf -fPIC -DORBIS -D__ORBIS__ -D__PS4__

INCDIRS := -I$(CURDIR)/include \
           -I$(VK_HEADERS)/include \
           -I$(OPENGNM_ROOT)/include \
           -I$(PSBC_ROOT)/libpsbc \
           -I$(PSBC_ROOT)/include \
           -I$(OO_PS4_TOOLCHAIN)/include \
           -I$(OO_PS4_TOOLCHAIN)/include/orbis

PSBC_LIB ?= $(PSBC_ROOT)/libpsbc.orbis.a
ifeq ($(wildcard $(PSBC_LIB)),)
$(error Orbis libpsbc not found at $(PSBC_LIB). Build it with: make -C $(PSBC_ROOT) -f Makefile.orbis)
endif

DEFINES := -DVK_USE_PLATFORM_PS4 -DVK_PS4_HAVE_PSBC=1

CFLAGS := $(ARCHFLAGS) $(INCDIRS) $(DEFINES) -std=c11 -O2 -g \
          -Wall -Wextra -Wno-unused-function \
          -Wno-macro-redefined -Wno-typedef-redefinition
CXXFLAGS := $(ARCHFLAGS) $(INCDIRS) $(DEFINES) -std=c++17 -O2 -g \
            -Wall -Wextra -Wno-unused-function \
            -Wno-macro-redefined -Wno-typedef-redefinition

# === Sources ===
# libpsbc is linked from the orbis-targeted archive above so shader modules
# compile SPIR-V to PS4 GCN binaries at runtime.
VK_PS4_SRCS := \
	src/vk_ps4_entry.c \
	src/vk_ps4_dispatch.c \
	src/vk_ps4_entrypoints.c \
	src/vk_ps4_instance.c \
	src/vk_ps4_device.c \
	src/vk_ps4_format.c \
	src/vk_ps4_memory.c \
	src/vk_ps4_buffer.c \
	src/vk_ps4_image.c \
	src/vk_ps4_render_pass.c \
	src/vk_ps4_shader.c \
	src/vk_ps4_pipeline.c \
	src/vk_ps4_descriptor.c \
	src/vk_ps4_command.c \
	src/vk_ps4_swapchain.c \
	src/vk_ps4_queue.c \
	src/vk_ps4_sync.c \
	src/vk_ps4_query.c \
	src/vk_ps4_stubs.c \
	src/vk_ps4_vulkan11.c \
	src/vk_ps4_log.c

VK_PS4_OBJS := $(VK_PS4_SRCS:.c=.orbis.o)

# === Output ===
LIB_NAME := vulkan_ps4
LIB_SHARED := lib$(LIB_NAME).so
LIB_STATIC := lib$(LIB_NAME).a

# === Test program (PS4 .self) ===
TEST_SRC := tests/test_triangle_ps4.c
TEST_OBJ := $(TEST_SRC:.c=.orbis.o)
# Mesa utility stubs (BLAKE3 SIMD, DXT format, logging) — linked into the test
# to resolve symbols that libpsbc.orbis.a references but doesn't include.
MESA_STUBS_SRC := src/mesa_stubs.c
MESA_STUBS_OBJ := $(MESA_STUBS_SRC:.c=.orbis.o)
TEST_ELF := test_triangle_ps4.elf
TEST_OELF := test_triangle_ps4.oelf
TEST_SELF := test_triangle_ps4.self
EBOOT := eboot.bin

# === Packaging tools (platform-specific) ===
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
    MKFSELF ?= $(OO_PS4_TOOLCHAIN)/bin/macos/create-fself-macos
    MKGP4   ?= $(OO_PS4_TOOLCHAIN)/bin/macos/create-gp4
    PKGTOOL ?= $(OO_PS4_TOOLCHAIN)/bin/macos/PkgTool.Core
else
    MKFSELF ?= $(OO_PS4_TOOLCHAIN)/bin/linux/create-fself
    MKGP4   ?= $(OO_PS4_TOOLCHAIN)/bin/linux/create-gp4
    PKGTOOL ?= $(OO_PS4_TOOLCHAIN)/bin/linux/PkgTool.Core
endif

# Paid for non-secure self (homebrew)
PAID := 0x3800000000000011

# Package metadata
PKG_TITLE := vulkan-ps4 Triangle Test
PKG_VERSION := 1.00
PKG_TITLE_ID := VPS400000
PKG_CONTENT_ID := IV0000-VPS400000_00-VKTRIANGLETEST00

# App link flags — link the test against libvulkan_ps4.a (static) + PS4 system libs
# PS4 homebrew statically links user libraries; only system libs are dynamic.
APP_LDFLAGS := -m elf_x86_64 --script $(OO_PS4_TOOLCHAIN)/link.x --eh-frame-hdr \
               -L$(OO_PS4_TOOLCHAIN)/lib -L$(CURDIR) $(LIBDIRS) \
               -pie -z max-page-size=0x4000 --gc-sections \
               --dynamic-linker /libexec/ld-elf.so.1

# Static link: libvulkan_ps4.a + libopengnm.a + libpsbc.orbis.a, then dynamic system libs
# --whole-archive for vulkan_ps4 + opengnm (cross-references between archives).
# libpsbc uses normal archive linking (selective pull) to avoid pulling in
# 477 Mesa objects with unresolved SIMD/format dependencies.
# Use deferred assignment (=) so OPENGNM_LIB (defined below) is resolved at use time.
APP_LIBS = --whole-archive $(LIB_STATIC) $(OPENGNM_LIB) --no-whole-archive \
           $(PSBC_LIB) $(PS4_LIBS)

# === Link flags ===
# Link against opengnm (orbis build), libpsbc, and OpenOrbis firmware stubs
OPENGNM_LIB := $(OPENGNM_LIBDIR)/libopengnm.a
ifeq ($(wildcard $(OPENGNM_LIB)),)
$(error Orbis opengnm archive not found at $(OPENGNM_LIB))
endif
LIBDIRS := -L$(OPENGNM_LIBDIR) -L$(PSBC_ROOT) -L$(OO_PS4_TOOLCHAIN)/lib

PS4_LIBS := -lkernel -lc -lc++ -lc++abi -lunwind \
            -lSceGnmDriver -lSceVideoOut

# opengnm and libpsbc (both PS4/FreeBSD ELF archives)
DEP_LIBS := -lopengnm $(PSBC_LIB)

LDFLAGS_SHARED := -shared -m elf_x86_64 \
                  --script $(OO_PS4_TOOLCHAIN)/link.x --eh-frame-hdr \
                  -L$(OO_PS4_TOOLCHAIN)/lib $(LIBDIRS) \
                  --gc-sections -z max-page-size=0x4000

.PHONY: all clean static shared self pkg

all: $(LIB_SHARED) $(LIB_STATIC)

# Build everything: library + test .self + .pkg
self: $(TEST_SELF)
pkg: $(PKG_CONTENT_ID).pkg

# === Build rules ===
%.orbis.o: %.c
	@echo "  CC $<"
	@$(CC) $(CFLAGS) -c $< -o $@

# === Static library ===
$(LIB_STATIC): $(VK_PS4_OBJS)
	@echo "  AR $@"
	@$(AR) rcs $@ $(VK_PS4_OBJS)

# === Shared library ===
$(LIB_SHARED): $(VK_PS4_OBJS)
	@echo "  LD $@"
	@$(LD) $(LDFLAGS_SHARED) -o $@ $(VK_PS4_OBJS) \
	    $(DEP_LIBS) $(PS4_LIBS)

# === Test program (PS4 .self) ===
# Compile the test source (uses the same orbis pattern rule)
$(TEST_OBJ): $(TEST_SRC)
	@echo "  CC $<"
	@$(CC) $(CFLAGS) -c $< -o $@

# Link the test ELF against libvulkan_ps4.a (static) + opengnm + libpsbc + PS4 libs
$(TEST_ELF): $(TEST_OBJ) $(MESA_STUBS_OBJ) $(LIB_STATIC)
	@echo "  LD $@"
	@$(LD) $(APP_LDFLAGS) -o $@ \
	    $(OO_PS4_TOOLCHAIN)/lib/crt1.o \
	    $(TEST_OBJ) $(MESA_STUBS_OBJ) $(APP_LIBS) \
	    $(OO_PS4_TOOLCHAIN)/lib/crtn.o

# Create the OELF (orbis ELF) from the plain ELF
$(TEST_OELF): $(TEST_ELF)
	@echo "  OELF $@"
	@$(MKFSELF) -in=$(TEST_ELF) -out=$(TEST_OELF) -eboot=$(EBOOT) --paid $(PAID)

# The .self is the eboot.bin renamed (create-fself produces eboot.bin)
$(TEST_SELF): $(TEST_OELF)
	@echo "  SELF $@"
	@cp $(EBOOT) $(TEST_SELF)

# === PKG packaging ===
# Reference sample for required PKG files (right.sprx, libc.prx, etc.)
SAMPLE_DIR ?= $(OO_PS4_TOOLCHAIN)/samples/hello_world

sce_sys:
	@mkdir -p sce_sys/about

sce_module:
	@mkdir -p $@

sce_sys/about/right.sprx: | sce_sys
	@cp $(SAMPLE_DIR)/sce_sys/about/right.sprx $@

sce_sys/icon0.png: | sce_sys
	@cp $(SAMPLE_DIR)/sce_sys/icon0.png $@

sce_module/libc.prx: | sce_module
	@cp $(SAMPLE_DIR)/sce_module/libc.prx $@

sce_module/libSceFios2.prx: | sce_module
	@cp $(SAMPLE_DIR)/sce_module/libSceFios2.prx $@

sce_sys/param.sfo: | sce_sys
	@echo "  SFO $@"
	@$(PKGTOOL) sfo_new $@
	@$(PKGTOOL) sfo_setentry $@ APP_TYPE --type Integer --maxsize 4 --value 1
	@$(PKGTOOL) sfo_setentry $@ APP_VER --type Utf8 --maxsize 8 --value '$(PKG_VERSION)'
	@$(PKGTOOL) sfo_setentry $@ ATTRIBUTE --type Integer --maxsize 4 --value 0
	@$(PKGTOOL) sfo_setentry $@ CATEGORY --type Utf8 --maxsize 4 --value 'gd'
	@$(PKGTOOL) sfo_setentry $@ CONTENT_ID --type Utf8 --maxsize 48 --value '$(PKG_CONTENT_ID)'
	@$(PKGTOOL) sfo_setentry $@ DOWNLOAD_DATA_SIZE --type Integer --maxsize 4 --value 0
	@$(PKGTOOL) sfo_setentry $@ SYSTEM_VER --type Integer --maxsize 4 --value 0
	@$(PKGTOOL) sfo_setentry $@ TITLE --type Utf8 --maxsize 128 --value '$(PKG_TITLE)'
	@$(PKGTOOL) sfo_setentry $@ TITLE_ID --type Utf8 --maxsize 12 --value '$(PKG_TITLE_ID)'
	@$(PKGTOOL) sfo_setentry $@ VERSION --type Utf8 --maxsize 8 --value '$(PKG_VERSION)'

PKG_FILES := eboot.bin sce_sys/about/right.sprx sce_sys/param.sfo \
             sce_sys/icon0.png sce_module/libc.prx sce_module/libSceFios2.prx

# Build the .gp4 manifest from the package files
pkg.gp4: $(TEST_SELF) sce_sys/param.sfo sce_sys/about/right.sprx sce_sys/icon0.png \
         sce_module/libc.prx sce_module/libSceFios2.prx
	@echo "  GP4 $@"
	@$(MKGP4) -out=$@ -content-id=$(PKG_CONTENT_ID) \
	    -files="$(PKG_FILES)"

# Final application package
$(PKG_CONTENT_ID).pkg: pkg.gp4
	@echo "  PKG $@"
	@$(PKGTOOL) pkg_build $< .

# === Clean ===
clean:
	rm -f $(VK_PS4_OBJS) $(LIB_SHARED) $(LIB_STATIC) \
	      $(TEST_OBJ) $(MESA_STUBS_OBJ) $(TEST_ELF) $(TEST_OELF) $(TEST_SELF) $(EBOOT) \
	      pkg.gp4 sce_sys/param.sfo sce_sys/about/right.sprx sce_sys/icon0.png \
	      sce_module/libc.prx sce_module/libSceFios2.prx $(PKG_CONTENT_ID).pkg
	@rm -rf sce_sys sce_module

# === Info ===
info:
	@echo "OO_PS4_TOOLCHAIN: $(OO_PS4_TOOLCHAIN)"
	@echo "OPENGNM_ROOT: $(OPENGNM_ROOT)"
	@echo "OPENGNM_LIBDIR: $(OPENGNM_LIBDIR)"
	@echo "PSBC_ROOT: $(PSBC_ROOT)"
	@echo "VK_HEADERS: $(VK_HEADERS)"
	@echo "CC: $(CC)"
	@echo "CFLAGS: $(CFLAGS)"
	@echo "LD: $(LD)"
	@echo "LDFLAGS_SHARED: $(LDFLAGS_SHARED)"
	@echo "Sources: $(VK_PS4_SRCS)"
	@echo "MKFSELF: $(MKFSELF)"
	@echo "MKGP4: $(MKGP4)"
	@echo "PKGTOOL: $(PKGTOOL)"
	@echo "Test self: $(TEST_SELF)"
	@echo "Package: $(PKG_CONTENT_ID).pkg"
